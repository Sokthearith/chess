{
  "name": "chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "engine:copy": "mkdir -p public/engine && cp node_modules/stockfish/bin/stockfish-19-lite-single.js node_modules/stockfish/bin/stockfish-19-lite-single.wasm public/engine/",
    "predev": "npm run engine:copy",
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "dev:all": "node scripts/dev-all.ts",
    "prebuild": "npm run engine:copy",
    "build": "tsc && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p server/tsconfig.json",
    "check:learn": "node scripts/check-learn.ts",
    "check:famous": "node scripts/check-famous.ts",
    "start": "node server/index.ts",
    "check:online": "node scripts/check-online.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "stockfish": "^19.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
